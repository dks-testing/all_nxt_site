{
  "name": "@platform/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./blocks": "./src/blocks.ts",
    "./preview": "./src/preview.ts",
    "./booking": "./src/booking.ts",
    "./booking-fields": "./src/booking-fields.ts",
    "./theme": "./src/theme.ts"
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=../../.env scripts/seed.ts",
    "db:sync-micks": "tsx --env-file=../../.env scripts/sync-micks-replica.ts",
    "db:upgrade": "tsx --env-file=../../.env scripts/upgrade-existing.ts",
    "test": "tsx --env-file=../../.env scripts/test-clone.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "dotenv": "^17.0.0"
  }
}
