# Either DATABASE_URL or the individual variables below can be used.
# DATABASE_URL=mysql://user:password@localhost:3306/shop_platform_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shop_platform_db
DB_SSL=false

# Local site/admin URLs and routing
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITES_APP_URL=http://localhost:3000
PLATFORM_ROOT_DOMAIN=localhost:3000

# Shared secrets. Set different random strings of at least 32 characters.
REVALIDATE_SECRET=replace-with-unique-32-character-secret
PREVIEW_SECRET=replace-with-another-32-character-secret
AUTH_SECRET=replace-with-session-32-character-secret
SESSION_SECRET=replace-with-session-32-character-secret

# Seed-only initial super admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# Hostinger SMTP (optional, for appointment notifications)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional provider alternatives
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

NEXT_PUBLIC_MEDIA_URL=/images_nextjs
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXX

# Domain DNS verification targets: configure the value(s) your platform provider gives you.
# DOMAIN_EXPECTED_A=76.76.21.21
# DOMAIN_EXPECTED_CNAME=cname.vercel-dns.com
